{
  "0": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_000",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_000",
    "description": "A child of man enters Anyx Trine... Interesting...",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_Q1_000_000",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_Q1_000_000",
    "description": "What will you ask?",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_A1_000_001",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_A1_000_001",
    "description": "Who are you?",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_A1_000_002",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_A1_000_002",
    "description": "What kind of place is this?",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_A1_000_003",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_A1_000_003",
    "description": "Nothing.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_010",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_010",
    "description": "I am Sehn Y Toh. My brothers and sisters are as one under Hraesvelgr. We purge this place of all who bear us ill will.",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_011",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_011",
    "description": "We seek quiet and calm. Those who deny us will be met with fangs and claws.",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_012",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_012",
    "description": "Heed me, mortal. Should you disturb the peace of our home, we will know...",
    "translation_description": ""
  },
  "8": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_020",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_020",
    "description": "Anyx Trine is the work of man in ages past.",
    "translation_description": ""
  },
  "9": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_021",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_021",
    "description": "But man has long forgotten the fruits of his labor.",
    "translation_description": ""
  },
  "10": {
    "name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_022",
    "translation_name": "TEXT_REGDRA2ANYXTRINE_00285_SEHNYTOH_000_022",
    "description": "The origins of Anyx Trine are not our concern. These grounds are silent. They suit our needs. Anyx Trine is our home now.",
    "translation_description": ""
  },
