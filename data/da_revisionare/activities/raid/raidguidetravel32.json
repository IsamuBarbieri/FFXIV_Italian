{
  "0": {
    "name": "TEXT_RAIDGUIDETRAVEL32_Q1_000_010",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_Q1_000_010",
    "description": "What would you like to do?",
    "translation_description": "Cosa desideri fare?"
  },
  "1": {
    "name": "TEXT_RAIDGUIDETRAVEL32_A1_000_011",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_A1_000_011",
    "description": "Learn about Midas (Savage).",
    "translation_description": "Scopri di più su Midas (Savage)."
  },
  "2": {
    "name": "TEXT_RAIDGUIDETRAVEL32_A1_000_012",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_A1_000_012",
    "description": "Enter \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (Loot Rule: Normal).",
    "translation_description": "Entra in \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (regola bottino: Normale)."
  },
  "3": {
    "name": "TEXT_RAIDGUIDETRAVEL32_A1_100_012",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_A1_100_012",
    "description": "Enter \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (Loot Rule: Greed Only).",
    "translation_description": "Entra in \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (regola bottino: Solo Brama)."
  },
  "4": {
    "name": "TEXT_RAIDGUIDETRAVEL32_A1_101_012",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_A1_101_012",
    "description": "Enter \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (Loot Rule: Lootmaster).",
    "translation_description": "Entra in \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (regola bottino: assegnazione al capogruppo)."
  },
  "5": {
    "name": "TEXT_RAIDGUIDETRAVEL32_A1_000_013",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_A1_000_013",
    "description": "Nothing.",
    "translation_description": "Niente."
  },
  "6": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_050",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_050",
    "description": "Midas (Savage) is comprised of multiple dungeons. Please be warned that the spell Return cannot be used in certain areas.",
    "translation_description": "Midas (Savage) comprende più aree. Attenzione: in alcune non è possibile usare l\u0027incantesimo Ritorno."
  },
  "7": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_051",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_051",
    "description": "Progress within Midas (Savage) is saved at specific locations for each player, and you may resume your foray where you left off.",
    "translation_description": "I progressi in Midas (Savage) vengono salvati in punti specifici per ogni giocatore; potrai riprendere l\u0027esplorazione da dove l\u0027hai interrotta."
  },
  "8": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_052",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_052",
    "description": "Progress is reset every \u003Chex:020603120303\u003E\u003Chex:020942DDFF0753756E646179FF074D6F6E646179FF0854756573646179FF0A5765646E6573646179FF095468757273646179FF07467269646179FF09536174757264617903\u003E at \u003Chex:020821DBFF1D020919DB02030405060708090A0B0C0D02030405060708090A0B0C030D03\u003E \u003Chex:020810E0DB0DFF05702E6D2EFF05612E6D2E03\u003E (Earth time).",
    "translation_description": "La progressione si azzera ogni \u003Chex:020603120303\u003E\u003Chex:020942DDFF0753756E646179FF074D6F6E646179FF0854756573646179FF0A5765646E6573646179FF095468757273646179FF07467269646179FF09536174757264617903\u003Ealle \u003Chex:020821DBFF1D020919DB02030405060708090A0B0C0D02030405060708090A0B0C030D03\u003E \u003Chex:020810E0DB0DFF05702E6D2EFF05612E6D2E03\u003E (ora terrestre)."
  },
  "9": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_053",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_053",
    "description": "To enter Midas (Savage), you must be in a party of eight Disciples of War or Magic with a level of 60 or higher.",
    "translation_description": "Per accedere a Midas (Savage), devi far parte di un gruppo di otto Discepoli della Guerra o della Magia di livello 60 o superiore."
  },
  "10": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_054",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_054",
    "description": "All members must also have completed the quest \u201CA Refrain for the Undaunted.\u201D",
    "translation_description": "Tutti i membri devono aver completato anche l\u0027incarico «Un ritornello per gli impavidi»."
  },
  "11": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_055",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_055",
    "description": "The starting point is determined by the party leader\u0027s progress.",
    "translation_description": "Il punto di partenza dipende dai progressi del capogruppo."
  },
  "12": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_056",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_056",
    "description": "Even party members whose progress is different may participate, provided they meet the entry requirements.",
    "translation_description": "Anche i membri del gruppo con una progressione diversa possono partecipare, purch\u00e9 soddisfino i requisiti di accesso."
  },
  "13": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_0561",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_0561",
    "description": "Those who have not advanced as far as the party leader will have their progress updated to be the same as that of the leader.",
    "translation_description": "Chi è meno avanti del capogruppo vedrà i propri progressi aggiornati allo stesso punto."
  },
  "14": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_057",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_057",
    "description": "Those who have advanced further than the party leader, on the other hand, will retain their progress.",
    "translation_description": "Chi invece è più avanti del capogruppo manterrà i propri progressi."
  },
  "15": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_100_057",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_100_057",
    "description": "In this latter case, you will not receive rewards from dungeons that you have already completed, and the number of coffers that pop will be adjusted accordingly.",
    "translation_description": "In tal caso non riceverai ricompense dalle spedizioni già completate; anche il numero di forzieri che appariranno verrà adeguato di conseguenza."
  },
  "16": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_058",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_058",
    "description": "All forays into Midas (Savage) are limited to 90 minutes (Earth time).",
    "translation_description": "Ogni spedizione in Midas (Savage) ha un limite di 90 minutes terrestri."
  },
  "17": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_059",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_059",
    "description": "All items in a player\u0027s loot list will automatically be transferred to that player\u0027s inventory upon all other party members leaving the area.",
    "translation_description": "Quando tutti gli altri membri del gruppo avranno lasciato l\u0027area, gli oggetti nell\u0027elenco bottino di ogni giocatore verranno trasferiti automaticamente nel suo inventario."
  },
  "18": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_060",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_060",
    "description": "Items unable to be obtained will be lost.",
    "translation_description": "Gli oggetti che non potrai ottenere andranno perduti."
  },
  "19": {
    "name": "TEXT_RAIDGUIDETRAVEL32_Q2_000_100",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_Q2_000_100",
    "description": "Enter \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (Loot Rule: Normal)?",
    "translation_description": "Vuoi entrare in \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (regola bottino: Normale)?"
  },
  "20": {
    "name": "TEXT_RAIDGUIDETRAVEL32_Q2_100_100",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_Q2_100_100",
    "description": "Enter \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (Loot Rule: Greed Only)?",
    "translation_description": "Vuoi entrare in \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (regola bottino: Solo Brama)?"
  },
  "21": {
    "name": "TEXT_RAIDGUIDETRAVEL32_Q2_101_100",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_Q2_101_100",
    "description": "Enter \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (Loot Rule: Lootmaster)?",
    "translation_description": "Vuoi entrare in \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8020403\u003E (regola bottino: assegnazione al capogruppo)?"
  },
  "22": {
    "name": "TEXT_RAIDGUIDETRAVEL32_A2_000_101",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_A2_000_101",
    "description": "Yes",
    "translation_description": "S\u00ec"
  },
  "23": {
    "name": "TEXT_RAIDGUIDETRAVEL32_A2_000_102",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_A2_000_102",
    "description": "No",
    "translation_description": "No"
  },
  "24": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_110",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_110",
    "description": "You were unable to enter \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8030403\u003E. Make sure that you and your party meet all the conditions.",
    "translation_description": "Impossibile entrare in \u003Chex:022815FF10496E7374616E6365436F6E74656E74E8030403\u003E. Assicurati che tu e il tuo gruppo soddisfiate tutti i requisiti."
  },
  "25": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_210",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_210",
    "description": "You have recently completed Midas (Savage), and cannot enter again until progress is reset.",
    "translation_description": "Hai appena completato Midas (Savage) e non potrai rientrarvi finché i progressi non verranno azzerati."
  },
  "26": {
    "name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_211",
    "translation_name": "TEXT_RAIDGUIDETRAVEL32_SYSTEM_000_211",
