{
  "0": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_RGHONATI_100_000",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_RGHONATI_100_000",
    "description": "More fool me for signing on to a company vessel bound for the other side of the world. Making a living out here won\u0027t be easy...",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_RGHONATI_110_000",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_RGHONATI_110_000",
    "description": "Part of the second expedition, are you? Me too! Turns out Hancock had work for me after all. More than enough to keep me fed with enough left over to browse Kogane Dori several times a week!",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_EXS00449_000_000",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_EXS00449_000_000",
    "description": "You\u0027re the \u201Cdab hand\u201D they summoned, aye? Afraid I can\u0027t help you at present. Still getting my own things in order...",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_Q1_000_000",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_Q1_000_000",
    "description": "What will you do?",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_A1_000_001",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_A1_000_001",
    "description": "Open lockboxes.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_A1_000_002",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_A1_000_002",
    "description": "Ask about lockboxes.",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_A1_000_003",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_A1_000_003",
    "description": "Nothing.",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_RGHONATI_100_010",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_RGHONATI_100_010",
    "description": "Huh. What an odd thing to ask. They\u0027re boxes with locks. If you want to get at whatever\u0027s inside, bring them to me and I\u0027ll open them for you.",
    "translation_description": ""
  },
  "8": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_EXS00449_000_010",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_EXS00449_000_010",
    "description": "Simply put, if you find any lockboxes during your exploration of Eureka, I have the tools and the skills to open them up. Just ask.",
    "translation_description": ""
  },
  "9": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_SYSTEM_000_011",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_SYSTEM_000_011",
    "description": "Lockboxes obtained in the Forbidden Land, Eureka, can be opened by expedition lockpicks in base camps or by R\u0027ghonati in Kugane.",
    "translation_description": ""
  },
  "10": {
    "name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_SYSTEM_000_012",
    "translation_name": "TEXT_CTSERKEUREKA1LOTTERYEXCHANGESHOP_00449_SYSTEM_000_012",
    "description": "Lockboxes may yield a variety of items, including mounts, minions, and materia.",
    "translation_description": ""
  },
