  },
  "27": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_3",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_3",
    "description": "<hex:024804F201F403><hex:024904F201F503>Submersible components<hex:0249020103><hex:0248020103> can be constructed in your company workshop. Please note that hull, stern, bow, and bridge components are required to outfit a submersible.",
