  "25": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_1",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_1",
    "description": "To outfit and register a submersible, you must have in your possession the requisite components and dive credits.",
    "translation_description": ""
  },
  "26": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_2",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_2",
    "description": "\u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003EDive credits\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E can be purchased from resident caretakers with company credits.",
    "translation_description": ""
  },
  "27": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_3",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_REGISTRATION_3",
    "description": "\u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003ESubmersible components\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E can be constructed in your company workshop. Please note that hull, stern, bow, and bridge components are required to outfit a submersible.",
    "translation_description": ""
  },
  "28": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_ENERGY",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_ENERGY",
    "description": "You cannot deploy your submersible on subaquatic voyages without ceruleum tanks, which can be purchased from resident caretakers with company credits.",
    "translation_description": ""
  },
  "29": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_EXPLOG_1",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_EXPLOG_1",
    "description": "Upon the completion of a subaquatic voyage, your mammet will provide a \u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003Evoyage log\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E detailing the results.",
    "translation_description": ""
  },
  "30": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_EXPLOG_2",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_EXPLOG_2",
    "description": "The information contained in this log may prove useful in preparing for your next subaquatic voyage.",
    "translation_description": ""
  },
  "31": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_EXPLOG_3",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_NO_EXPLOG_3",
    "description": "Please note that only the log for the previous voyage will be retained.",
    "translation_description": ""
  },
