  "22": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_SUBMARINE_NAME_MES_0",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_SUBMARINE_NAME_MES_0",
    "description": "Names must be formed from alphanumeric characters. The following punctuation marks are also allowed:\u003Chex:02100103\u003E\u003Chex:024804F201FC03\u003E\u003Chex:024904F201FD03\u003E\u0027\u003Chex:021D0103\u003E. , : ; ! ? \u0026 - _\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E\u003Chex:02100103\u003E\u2022 Double spaces/underscores are not allowed.\u003Chex:02100103\u003E\u2022 A space cannot be used before or after the name.\u003Chex:02100103\u003E\u2022 Names consisting solely of punctuation marks are prohibited.",
    "translation_description": ""
  },
  "23": {
    "name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_REMOVE_SUBMARINE_TITLE",
    "translation_name": "TEXT_HOUFIXCOMPANYSUBMARINE_00447_REMOVE_SUBMARINE_TITLE",
    "description": "Are you certain you wish to dismantle \u003Chex:021A020203\u003E\u003Chex:022903EA0203\u003E\u003Chex:021A020103\u003E?\u003Chex:02100103\u003E\u003Chex:024804F201FC03\u003E\u003Chex:024904F201FD03\u003EPlease note that while submersible components will be returned, your submersible\u0027s registration, rank, and accrued experience will be lost.\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E",
    "translation_description": ""
  },
