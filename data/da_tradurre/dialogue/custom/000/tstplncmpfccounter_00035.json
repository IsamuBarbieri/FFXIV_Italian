    "translation_description": ""
  },
  "50": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_A99_000_9",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_A99_000_9",
    "description": "いまはいい。",
