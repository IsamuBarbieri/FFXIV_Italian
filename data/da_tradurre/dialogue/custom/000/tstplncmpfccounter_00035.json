  },
  "51": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9910_1",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9910_1",
    "description": "＜フリーカンパニー説明＞",
    "translation_description": ""
  },
  "52": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_1",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_1",
    "description": "フリーカンパニーを結成するには、<hex:02100103>3つの条件と結成費用100000ギルが必要になります。",
    "translation_description": ""
  },
  "53": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_2",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_2",
    "description": "条件1～ランクが25以上のクラスを持っている<hex:02100103>条件2～結成に同意する3人の署名を集める<hex:02100103>条件3～フリーカンパニーに所属していない",
    "translation_description": ""
  },
  "54": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_3",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_3",
    "description": "フリーカンパニーを抜けてから48時間経過しないと<hex:02100103>無所属として認められないので気をつけてください。",
    "translation_description": ""
  },
  "55": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_4",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_4",
    "description": "署名者に関してもフリーカンパニーに所属していないことが<hex:02100103>求められます。",
    "translation_description": ""
  },
  "56": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_5",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_5",
    "description": "以上の条件と費用を確認したうえで<hex:02100103>結成者をリーダーとする4人のライトパーティーを組み、<hex:02100103>当窓口にて結成の申請を行ってください。",
    "translation_description": ""
  },
  "57": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_6",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9920_6",
    "description": "結成が完了すると申請者はフリーカンパニーのマスターに、<hex:02100103>署名者はメンバーとしてフリーカンパニーに所属します。",
    "translation_description": ""
  },
  "58": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9930_1",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9930_1",
    "description": "フリーカンパニーを解散するには<hex:02100103>所属しているメンバーがいない状態にし、<hex:02100103>カンパニー資産も空にしておく必要があります。",
    "translation_description": ""
  },
  "59": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9930_2",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9930_2",
    "description": "準備が整ったら当窓口で解散の申請を行ってください。",
    "translation_description": ""
  },
  "60": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9940_1",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9940_1",
    "description": "所属の移籍は現在所属していないグランドカンパニーの<hex:02100103>フリーカンパニー窓口で申請することができます。<hex:02100103>",
    "translation_description": ""
  },
  "61": {
    "name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9940_2",
    "translation_name": "TEXT_TSTPLNCMPFCCOUNTER_00035_FCINFO_9940_2",
    "description": "移籍をするとフリーカンパニーランキングのポイントはリセット、<hex:02100103>受注済みのカンパニーデューティーはキャンセルとなりますので<hex:02100103>お気をつけください。",
    "translation_description": ""
  }
