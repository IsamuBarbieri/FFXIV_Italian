  "16": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_MANUAL00539_000_020",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_MANUAL00539_000_020",
    "description": "(-Mnemeworks Manual-)\u201CIt is strongly recommended that you familiarize yourself with all aspects of the mnemeworks station before attempting to enhance an armament. Failure to do so may lead to catastrophic failure and/or grievous bodily harm and/or death...\u201D",
    "translation_description": ""
  },
  "17": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_021",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_021",
    "description": "Through the use of the mnemeworks, you may imbue your Pyros weapon with additional properties.",
    "translation_description": ""
  },
  "18": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_022",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_022",
    "description": "The strength and nature of these properties will be determined at random. Moreover, should you possess sufficient materials, this process may be repeated.",
    "translation_description": ""
  },
  "19": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_MANUAL00539_000_030",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_MANUAL00539_000_030",
    "description": "(-Mnemeworks Manual-)\u201CPlease ensure you have sufficient \u003Chex:02310DFF054974656D04F25E3A030203\u003E before utilizing the mnemeworks station. Failure to do so may lead to catastrophic failure and/or grievous bodily harm and/or death...\u201D",
    "translation_description": ""
  },
  "20": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_031",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_031",
    "description": "In order to enhance a Pyros weapon, you must possess the requisite quantity of \u003Chex:02310DFF054974656D04F25E3A030203\u003E.",
    "translation_description": ""
  },
  "21": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_032",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_032",
    "description": "This quantity will vary depending on the weapon in question. A paladin\u0027s arm requires \u003Chex:020860E802FF54020850E2E8020BFF4202093EE802FF046F6E65FF0474776FFF067468726565FF05666F7572FF0566697665FF04736978FF06736576656EFF066569676874FF056E696E65FF0474656E03FF07022003E8020303FF07022003E8020303\u003E, as does a shield. All other weapons require \u003Chex:020860E804FF54020850E2E8040BFF4202093EE804FF046F6E65FF0474776FFF067468726565FF05666F7572FF0566697665FF04736978FF06736576656EFF066569676874FF056E696E65FF0474656E03FF07022003E8040303FF07022003E8040303\u003E \u003Chex:02310DFF054974656D04F25E3A030203\u003E.",
    "translation_description": ""
  },
  "22": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_033",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_033",
    "description": "\u003Chex:022B13FF1102310DFF054974656D04F25E3A03020303\u003E are created by converting accumulated vitiated aether with the aid of a Mark II crystal forge.",
    "translation_description": ""
  },
  "23": {
    "name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_034",
    "translation_name": "TEXT_CTSERKEUREKA3ADJUSTTOOL_00539_SYSTEM_000_034",
    "description": "Please be advised that \u003Chex:02310DFF054974656D04F25E3A030203\u003E can only be obtained via the Mark II crystal forge located in \u003Chex:02281CFF17436F6E74656E7446696E646572436F6E646974696F6EE8022C03\u003E, and that crystal forges located elsewhere will not yield this material.",
    "translation_description": ""
  },
