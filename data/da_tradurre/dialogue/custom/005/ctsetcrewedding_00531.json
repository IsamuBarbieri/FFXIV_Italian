{
  "0": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_000",
    "description": "Good day to you, <hex:020816E905FF086D79206C616479FF09676F6F642073697203>. My name is Hawu Bajihri, and it is both my honor and privilege to assist happily bonded couples who wish to celebrate their anniversary and renew their vows.",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_001",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_001",
    "description": "I very much look forward to the day you have need of my services.",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_010",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_010",
    "description": "Good day to you, <hex:020816E905FF086D79206C616479FF09676F6F642073697203>. I do hope you and your beloved have been well.",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_011",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_011",
    "description": "As you may know, it is my duty to oversee the renewal of vows between bonded couples who have registered their anniversary with the Sanctum of the Twelve. Should you have need of my services, pray do not hesitate to ask.",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_012",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_012",
    "description": "To register your anniversary, you and your partner must be in a party together with your eternity rings in your inventory.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_CTSETCREWEDDING_00531_Q1_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_Q1_000_000",
    "description": "What will you do?",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_CTSETCREWEDDING_00531_A1_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_A1_000_000",
    "description": "Register your anniversary.",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_CTSETCREWEDDING_00531_A1_000_001",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_A1_000_001",
    "description": "Inquire about anniversaries at the Sanctum.",
    "translation_description": ""
  },
  "8": {
    "name": "TEXT_CTSETCREWEDDING_00531_A1_000_002",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_A1_000_002",
    "description": "Nothing.",
    "translation_description": ""
  },
  "9": {
    "name": "TEXT_CTSETCREWEDDING_00531_Q2_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_Q2_000_000",
    "description": "Register your anniversary with the Sanctum of the Twelve?",
    "translation_description": ""
  },
  "10": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_020",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_020",
    "description": "Very well. If you should change your mind you need but ask.",
    "translation_description": ""
  },
  "11": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_021",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_021",
    "description": "Splendid! The <hex:> of...<hex:020965E802FF084A616E75617279FF094665627275617279FF064D61726368FF06417072696CFF044D6179FF054A756E65FF054A756C79FF07417567757374FF0A53657074656D626572FF084F63746F626572FF094E6F76656D626572FF09446563656D62657203>. Am I reading that right? I shall draw up the necessary papers and inform Raitmeaux at once.",
    "translation_description": ""
  },
  "12": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_022",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_022",
    "description": "I believe I speak for all here at the Sanctum when I say we look forward to your return.",
    "translation_description": ""
  },
  "13": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_023",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_023",
    "description": "The anniversary date engraved on your eternity ring has been registered with the Sanctum of the Twelve.",
    "translation_description": ""
  },
  "14": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_024",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_024",
    "description": "When the day of your anniversary arrives, you will receive a notification the next time you enter the East Shroud or any town.",
    "translation_description": ""
  },
  "15": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_025",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_025",
    "description": "You may then speak with Hawu Bajihri to undertake the quest “The Ties that Bind,” beginning from the ceremony planning stage of the quest, and renew your vows in the Ceremony of Eternal Bonding.",
    "translation_description": ""
  },
  "16": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_030",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_030",
    "description": "Be it your first or fiftieth, the anniversary of an eternal bond is an important malmstone.",
    "translation_description": ""
  },
  "17": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_031",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_031",
    "description": "And to celebrate such a momentous occasion, we believe each and every blessed couple that walks the Sanctum's halls deserves the opportunity to relive the joyous day they pledged their devotion to one another.",
    "translation_description": ""
  },
  "18": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_032",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_032",
    "description": "Of course, this is not to say your ceremony should be <hex:021A020203>exactly<hex:021A020103> as it was before. All of our resources will be at your disposal, that you may have a ceremony as modest or extravagant as you desire.",
    "translation_description": ""
  },
  "19": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_033",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_033",
    "description": "To register your anniversary, you and your partner must be in a party together with your eternity rings in your inventory.",
    "translation_description": ""
  },
  "20": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_034",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_034",
    "description": "Should you choose to register, you will have the option to celebrate your anniversary on or after the date engraved on your eternity ring.",
    "translation_description": ""
  },
  "21": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_040",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_040",
    "description": "<hex:020867E4E80202FF5F4920616D207465727269626C7920736F7272792C2002080FE905FF066D6164616DFF04736972032C206275742077652063616E6E6F742070726F6365737320796F757220726567697374726174696F6E20617420746869732074696D652EFF0103><hex:><hex:02087DE4E80204FF754920616D207465727269626C7920736F7272792C2002080FE905FF066D6164616DFF04736972032C2062757420626F746820796F7520616E6420796F757220706172746E6572206D7573742062652070726573656E7420746F20726567697374657220796F757220616E6E69766572736172792EFF0103><hex:020872E4E80205FF6A4920616D207465727269626C7920736F7272792C2002080FE905FF066D6164616DFF04736972032C20627574206974207365656D7320796F757220706172746E65722068617320616C7265616479207265676973746572656420616E20616E6E69766572736172792EFF0103><hex:><hex:><hex:><hex:><hex:020887E4E8020AFF7F4920616D207465727269626C7920736F7272792C2002080FE905FF066D6164616DFF04736972032C2062757420697420776F756C64207365656D20796F757220706172746E657220686173206E6F74207965742066696E6973686564207769746820796F757220636572656D6F6E7927732070726F63656564696E67732EFF0103>",
    "translation_description": ""
  },
  "22": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_041",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_041",
    "description": "Good day to you, <hex:020816E905FF086D79206C616479FF09676F6F642073697203>. I do hope you and your beloved have been well. Have you need of my services?",
    "translation_description": ""
  },
  "23": {
    "name": "TEXT_CTSETCREWEDDING_00531_Q3_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_Q3_000_000",
    "description": "What will you say?",
    "translation_description": ""
  },
  "24": {
    "name": "TEXT_CTSETCREWEDDING_00531_A3_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_A3_000_000",
    "description": "I would like to confirm the date of my anniversary.",
    "translation_description": ""
  },
  "25": {
    "name": "TEXT_CTSETCREWEDDING_00531_A3_000_001",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_A3_000_001",
    "description": "I wish to cancel my registration with the Sanctum.",
    "translation_description": ""
  },
  "26": {
    "name": "TEXT_CTSETCREWEDDING_00531_A3_000_002",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_A3_000_002",
    "description": "I wish to renew my vows.",
    "translation_description": ""
  },
  "27": {
    "name": "TEXT_CTSETCREWEDDING_00531_A3_000_003",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_A3_000_003",
    "description": "Nothing.",
    "translation_description": ""
  },
  "28": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_050",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_050",
    "description": "Ah yes, the date of your anniversary. Our records show you and your beloved were joined on the <hex:> of... What was it again? <hex:020965E802FF084A616E75617279FF094665627275617279FF064D61726368FF06417072696CFF044D6179FF054A756E65FF054A756C79FF07417567757374FF0A53657074656D626572FF084F63746F626572FF094E6F76656D626572FF09446563656D62657203>! Yes, the <hex:> of <hex:020965E802FF084A616E75617279FF094665627275617279FF064D61726368FF06417072696CFF044D6179FF054A756E65FF054A756C79FF07417567757374FF0A53657074656D626572FF084F63746F626572FF094E6F76656D626572FF09446563656D62657203>. Forgive me, even now the Sanctum's methods for cataloging dates leave me perplexed at times.",
    "translation_description": ""
  },
  "29": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_051",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_051",
    "description": "Please note the option to celebrate your anniversary is only available on or after the date engraved on your eternity ring.",
    "translation_description": ""
  },
  "30": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_052",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_052",
    "description": "You would no longer be allowed to celebrate your anniversary here at the Sanctum of the Twelve. Are you quite certain this is what you want?",
    "translation_description": ""
  },
  "31": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_053",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_053",
    "description": "Please note you can speak with Hawu Bajihri at any time to re-register your anniversary with the Sanctum of the Twelve.",
    "translation_description": ""
  },
  "32": {
    "name": "TEXT_CTSETCREWEDDING_00531_Q4_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_Q4_000_000",
    "description": "Cancel your anniversary registration?",
    "translation_description": ""
  },
  "33": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_054",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_054",
    "description": "Very well. I shall have you and your beloved's names removed from our records. Should you have a change of heart, please do not hesitate to come and speak with me. ",
    "translation_description": ""
  },
  "34": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_060",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_060",
    "description": "Though I do admire your enthusiasm, our records show your anniversary has not yet come to pass. I am afraid you will have to wait a while longer.",
    "translation_description": ""
  },
  "35": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_061",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_061",
    "description": "My, how time flies. On behalf of all here at the Sanctum of the Twelve, let me be the first to offer you and your partner congratulations.",
    "translation_description": ""
  },
  "36": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_062",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_062",
    "description": "You need but say the word and we will begin preparations for your ceremony at once.",
    "translation_description": ""
  },
  "37": {
    "name": "TEXT_CTSETCREWEDDING_00531_Q5_000_000",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_Q5_000_000",
    "description": "To renew your vows, you must undertake the quest “The Ties that Bind,” starting from the ceremony planning stage of the quest.<hex:02100103>Proceed?",
    "translation_description": ""
  },
  "38": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_063",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_063",
    "description": "Understood. There is no need to rush, after all.",
    "translation_description": ""
  },
  "39": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_064",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_064",
    "description": "I shall have our acolytes make ready, then.",
    "translation_description": ""
  },
  "40": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_065",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_065",
    "description": "May the Twelve never let the memory of this blessed day fade from your hearts.",
    "translation_description": ""
  },
  "41": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_066",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_066",
    "description": "You received a promise wristlet. ",
    "translation_description": ""
  },
  "42": {
    "name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_067",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_SYSTEM_000_067",
    "description": "You may now proceed with the quest “The Ties that Bind,” starting from the ceremony planning stage.",
    "translation_description": ""
  },
  "43": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_069",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_069",
    "description": "Do not let me keep you waiting. Your ceremony awaits!",
    "translation_description": ""
  },
  "44": {
    "name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_068",
    "translation_name": "TEXT_CTSETCREWEDDING_00531_HAWUBAJIHRI_000_068",
    "description": "<hex:02088CE4E80204FF844F6820646561722E204974207365656D7320796F7520617265206E6F7420717569746520726561647920746F20626567696E20706C616E6E696E6720796F757220636572656D6F6E792E205072617920737065616B2077697468206D6520616761696E207768656E20796F757220616666616972732061726520696E206F726465722EFF0103><hex:><hex:><hex:0208F0D6E4E80207FFCF4920616D207465727269626C7920736F7272792C2002080FE905FF066D6164616DFF0473697203><hex:><hex:02086BE4E80208FF634D792061706F6C6F676965732C2002080FE905FF066D6164616DFF04736972032C2062757420492063616E6E6F74207365656D20746F2066696E6420796F75722070726F6F66206F72206964656E7469747920696E206F7572207265636F7264732EFF0103><hex:020875E4E80209FF6D4D792061706F6C6F676965732C2002080FE905FF066D6164616DFF04736972032C2062757420492063616E6E6F74207365656D20746F2066696E6420796F757220706172746E657227732070726F6F66206F72206964656E7469747920696E206F7572207265636F7264732EFF0103>",
    "translation_description": ""
  }
}