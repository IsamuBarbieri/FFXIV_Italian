  "1": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_010",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_010",
    "description": "...Ah, a thousand pardons, \u003Chex:02080EE905FF056D697373FF0473697203\u003E. Due to the dangers our parties often face on these expeditions, we can accept only the most experienced individuals.",
    "translation_description": ""
