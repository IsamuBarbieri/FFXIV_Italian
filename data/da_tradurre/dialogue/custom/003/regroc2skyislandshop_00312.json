    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_012",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_012",
    "description": "\u203BYou must have completed the main scenario quest \u201CHeavensward.\u201D",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_013",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_013",
