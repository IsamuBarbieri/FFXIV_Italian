{
  "0": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_000",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_000",
    "description": "Will you be registering for the next mission? If so, you will need to submit proof of purchase for a tank of ceruleum.",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_010",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_010",
    "description": "...Ah, a thousand pardons, <hex:02080EE905FF056D697373FF0473697203>. Due to the dangers our parties often face on these expeditions, we can accept only the most experienced individuals.",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_011",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_011",
    "description": "In order to embark upon an Ishgardian exploratory mission, you and your party must meet the following requirements:",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_012",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_012",
    "description": "※You must have completed the main scenario quest “Heavensward.”",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_013",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_013",
    "description": "You must be a level 60 Disciple of War or Magic.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_014",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_SYSTEM_000_014",
    "description": "To review your quest progression, select <hex:024804F201F403><hex:024904F201F503>Duty<hex:0249020103><hex:0248020103> from the main menu, followed by <hex:024804F201F403><hex:024904F201F503>Journal<hex:0249020103><hex:0248020103>.",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_020",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_JAQUOINIE_000_020",
    "description": "Wait─have you spoken with Lord Aurvael yet? I thought not. It would be best if you did so first.",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_REGROC2SKYISLANDSHOP_00312_Q1_000_000",
    "translation_name": "TEXT_REGROC2SKYISLANDSHOP_00312_Q1_000_000",
    "description": "What would you like to do?",
    "translation_description": ""
  },
