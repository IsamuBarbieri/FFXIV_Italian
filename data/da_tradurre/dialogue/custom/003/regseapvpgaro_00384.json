{
  "0": {
    "name": "TEXT_REGSEAPVPGARO_00384_Q1_000_000",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_Q1_000_000",
    "description": "What will you do?",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_REGSEAPVPGARO_00384_A1_000_001",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_A1_000_001",
    "description": "Exchange Wolf Marks. (Melee) I",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_REGSEAPVPGARO_00384_A1_000_002",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_A1_000_002",
    "description": "Exchange Wolf Marks. (Melee) II",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_REGSEAPVPGARO_00384_A1_100_002",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_A1_100_002",
    "description": "Exchange Wolf Marks. (Ranged)",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_REGSEAPVPGARO_00384_A1_000_003",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_A1_000_003",
    "description": "Receive a new title.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_REGSEAPVPGARO_00384_A1_000_004",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_A1_000_004",
    "description": "Ask about titles.",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_REGSEAPVPGARO_00384_A1_000_005",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_A1_000_005",
    "description": "Ask about the priest.",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_REGSEAPVPGARO_00384_A1_000_006",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_A1_000_006",
    "description": "Nothing.",
    "translation_description": ""
  },
  "8": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_001",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_001",
    "description": "Ah, so you wish to stand amongst the favored, do you? Hmmm. Well, let me take a look at you...",
    "translation_description": ""
  },
  "9": {
    "name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_003_002",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_003_002",
    "description": "The disreputable priest will award you a new title if the combination of your job and currently equipped gear meets with her approval.",
    "translation_description": ""
  },
  "10": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_003",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_003",
    "description": "What need have you of more titles? You are become the very embodiment of warrior spirit! The shining pinnacle of martial perfection! Go! Fall upon your foes like an avenging god!",
    "translation_description": ""
  },
  "11": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_004",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_004",
    "description": "...Again, favored of the \u003Chex:\u003E? I have already bestowed upon you a title befitting your resplendence. Go! Shower yourself in glory, and prove I was not wrong in my appraisal of your worth.",
    "translation_description": ""
  },
  "12": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_005_001",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_005_001",
    "description": "Favored of the \u003Chex:\u003E, once more\u2500but glory once attained is forever borne!",
    "translation_description": ""
  },
  "13": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_005_002",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_005_002",
    "description": "Rest not upon your laurels, but gather them. A warrior so favored by the gods is hindered by no one and cowed by naught. Go! Ascend now to the heights of new and unequivocal power!",
    "translation_description": ""
  },
  "14": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_005",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_005",
    "description": "...Yes, you wear it well. Henceforth, you shall be known as the favored of the \u003Chex:\u003E, and have a new title to bear into battle! Go! Earn the accolades of the gods of war!",
    "translation_description": ""
  },
  "15": {
    "name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_003_006",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_003_006",
    "description": "Set your newly obtained appellation to your current title, then win victories in PvP to earn new achievements.",
    "translation_description": ""
  },
  "16": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_007",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_007",
    "description": "...Yes, you wear it well. Henceforth, you shall be known as the favored of the \u003Chex:\u003E, and have a new title to bear into battle!",
    "translation_description": ""
  },
  "17": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_008",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_008",
    "description": "...But could it be? Have you stood before me clad in the armors of every combat art? You are the one. The master of makai. Your name shall echo across the battlefield, and how your foes shall tremble!",
    "translation_description": ""
  },
  "18": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_009",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_003_009",
    "description": "...Ah. That is not \u003Chex:021A020203\u003Equite\u003Chex:021A020103\u003E what I was looking for. Those who would bear the titles of the favored must personify perfection\u2500I cannot settle for aught less.",
    "translation_description": ""
  },
  "19": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_103_009",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_103_009",
    "description": "...Hm. That is not \u003Chex:021A020203\u003Equite\u003Chex:021A020103\u003E the perfection I envisioned. I cannot settle for aught less. And you, most favored of the gods\u2500you are capable of such sublimity.",
    "translation_description": ""
  },
  "20": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_004_001",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_004_001",
    "description": "Have you browsed my precious stock, and earned from me the arms and armor of proven champions? Stand before me clad in these trophies, and mayhap I shall name you one of the favored.",
    "translation_description": ""
  },
  "21": {
    "name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_004_002",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_004_002",
    "description": "Equip a full set of armor (head, body, hands, legs, feet) and matching class weapon purchased from the disreputable priest, and present yourself to her to receive a special title.",
    "translation_description": ""
  },
  "22": {
    "name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_004_003",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_004_003",
    "description": "Please note that samurai, red mages, gunbreakers, dancers, reapers, and sages are not required to equip a weapon.",
    "translation_description": ""
  },
  "23": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_001_001",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_001_001",
    "description": "My name is not important...only my faith. I have journeyed from afar to discover the ultimate combatant\u2500the favored child of all the gods of war.",
    "translation_description": ""
  },
  "24": {
    "name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_001_002",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_HOUSHI_001_002",
    "description": "But I will not judge paupers draped in unsightly rags. This champion must draw the eye and inspire the heart! Come to me with the currency of battle, and I shall gift unto you arms and armor of suitable magnificence.",
    "translation_description": ""
  },
  "25": {
    "name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_001_002",
    "translation_name": "TEXT_REGSEAPVPGARO_00384_SYSTEM_001_002",
    "description": "Trade \u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003EWolf Marks\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E to the disreputable priest to purchase powerful weapons and gear for use in PvP.",
    "translation_description": ""
  }
}