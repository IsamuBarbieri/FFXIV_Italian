{
  "0": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_000",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_000",
    "description": "Oh, are you a traveler? Let me be one of the first to welcome you to Tailfeather!",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_Q1_000_000",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_Q1_000_000",
    "description": "What will you ask?",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_A1_000_001",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_A1_000_001",
    "description": "What do you do here?",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_A1_000_002",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_A1_000_002",
    "description": "What kind of place is this?",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_A1_000_003",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_A1_000_003",
    "description": "Nothing.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_010",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_010",
    "description": "What\u0027s it look like? I\u0027m learnin\u0027 the huntin\u0027 trade, just like my folks! Now, I haven\u0027t actually \u003Chex:021A020203\u003Ehunted\u003Chex:021A020103\u003E yet, but I\u0027ve got my hands full just helpin\u0027 out \u0027round the camp. ",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_011",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_011",
    "description": "Gettin\u0027 huntin\u0027 supplies, takin\u0027 care of the birds... Why, even now I\u0027m lookin\u0027 over this fresh-caught chocobo. The other hunters say I ain\u0027t too bad with a bow, either!",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_020",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_020",
    "description": "Hunters from all \u0027round make this encampment their base. Some are here hopin\u0027 to make a fortune, others are here \u0027cause they got nothin\u0027 better to do. You meet all sorts in this camp\u2500there ain\u0027t never a dull moment!",
    "translation_description": ""
  },
  "8": {
    "name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_021",
    "translation_name": "TEXT_REGDRA2TAILFEATHER_00283_COLINA_000_021",
    "description": "This forest is just teemin\u0027 with wild chocobos, and if you catch yourself a big one, merchants from Ishgard will pay buckets of gil for it! It\u0027s that thrill that keeps us goin\u0027 in the face of bandersnatches and dragons.",
    "translation_description": ""
  },
