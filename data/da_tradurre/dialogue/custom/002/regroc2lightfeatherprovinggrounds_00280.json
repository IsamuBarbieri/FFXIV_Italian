{
  "0": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_000",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_000",
    "description": "Oh! Hello there. Welcome to the Lightfeather Proving Grounds.",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_Q1_000_000",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_Q1_000_000",
    "description": "What will you ask?",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_001",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_001",
    "description": "What do you do here?",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_002",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_002",
    "description": "What kind of place is this?",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_003",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_003",
    "description": "Nothing.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_010",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_010",
    "description": "Officially, I\u0027m supposed to show people around and answer their questions, but in practice, that\u0027s hardly necessary, as we rarely see new faces around here.",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_011",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_011",
    "description": "Not that I mind. I rather like being free to watch the fights.",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_020",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_020",
    "description": "As you might expect from the name, the Lightfeather Proving Grounds were originally established to host matches for battle-trained chocobos.",
    "translation_description": ""
  },
  "8": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_021",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_021",
    "description": "That being said, House Dzemael has since allowed the grounds to be used for other purposes on occasion.",
    "translation_description": ""
  },
  "9": {
    "name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_022",
    "translation_name": "TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_022",
    "description": "Some other houses have staged spectacles, for both private and public amusement. The Temple Knights have also held exhibitions in the past as well\u2500those are always a delight, believe you me.",
    "translation_description": ""
  },
