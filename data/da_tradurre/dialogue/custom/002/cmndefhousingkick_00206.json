{
  "0": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_TALK00206_000_001",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_TALK00206_000_001",
    "description": "In the event you are...divested of your property, we shall collect your furnishings for safekeeping\u2500those which may be safely removed, that is. Furthermore, should the property in question be an estate, you may claim indemnification for four\u003Chex:021F0103\u003Efifths the plot\u0027s value.",
    "translation_description": ""
  },
  "1": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_TALK00206_000_002",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_TALK00206_000_002",
    "description": "However, pray understand that we offer these services only as a courtesy\u2500and for a limited time.",
    "translation_description": ""
  },
  "2": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_001_000",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_001_000",
    "description": "There are no abandoned possessions to be claimed.",
    "translation_description": ""
  },
  "3": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_001_001",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_001_001",
    "description": "You cannot claim abandoned estate possessions at this time. Please confirm that you have the authority to purchase and relinquish land for your free company.",
    "translation_description": ""
  },
  "4": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_002_000",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_002_000",
    "description": "Another player is claiming abandoned possessions at this time. Please try again later.",
    "translation_description": ""
  },
  "5": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_002_001",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_002_001",
    "description": "You cannot claim abandoned estate possessions at this time. Please confirm that you have the authority to purchase and relinquish land for your free company, and that items are being held by the resident caretaker.",
    "translation_description": ""
  },
  "6": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_003_000",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_003_000",
    "description": "The indemnification for this estate has already been claimed.",
    "translation_description": ""
  },
  "7": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_003_001",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_SYSTEM_003_001",
    "description": "Unable to claim indemnification. You cannot carry any more gil.",
    "translation_description": ""
  },
  "8": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_TALK00206_000_000",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_TALK00206_000_000",
    "description": "Ah, \u003Chex:020811E905FF054D697373FF074D697374657203\u003E \u003Chex:022C0DFF07022903EB0203FF02200303\u003E. My sincerest condolences. I presume you wish to discuss your property?",
    "translation_description": ""
  },
  "9": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_Q1_000_000",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_Q1_000_000",
    "description": "What would you like to do?",
    "translation_description": ""
  },
  "10": {
    "name": "TEXT_CMNDEFHOUSINGKICK_00206_A1_000_001",
    "translation_name": "TEXT_CMNDEFHOUSINGKICK_00206_A1_000_001",
    "description": "Claim personal estate possessions and indemnification.",
    "translation_description": ""
  },
