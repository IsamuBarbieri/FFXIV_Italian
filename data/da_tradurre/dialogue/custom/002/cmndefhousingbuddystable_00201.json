  "21": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A1",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A1",
    "description": "It is possible to train your chocobo while he is stabled. Doing so will grant him Companion EXP. To train a chocobo, you must first prepare \u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003Efeed\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E to use as a \u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003Etreat\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E.",
    "translation_description": ""
  },
  "22": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A2",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A2",
    "description": "After training, you must allow your chocobo to rest and recuperate before he can be trained again.",
    "translation_description": ""
  },
  "23": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A3",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A3",
    "description": "When your chocobo has accumulated the maximum amount of Companion EXP for his current rank, you may increase his rank through battle.",
    "translation_description": ""
  },
  "24": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A4",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A4",
    "description": "Additionally, if your chocobo has already attained the maximum rank, you can feed him a Thavnairian onion following training to increase this upper limit.",
    "translation_description": ""
  },
  "25": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A5",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A5",
    "description": "It is also possible to train others\u0027 chocobos if you have the authority to do so. However, please note that you cannot raise the maximum rank of others\u0027 chocobos, nor can you influence their feed preferences.",
    "translation_description": ""
  },
  "26": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A6",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_A6",
    "description": "Chocobos must rest and recuperate between your training sessions. However, because they react positively to new stimulation, other members can train the same chocobo during this period\u2500after which they will have to wait before they can do so again.",
    "translation_description": ""
  },
  "27": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B1",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B1",
    "description": "Certain types of feed may be used to grant beneficial effects to your chocobo when he is summoned to battle.",
    "translation_description": ""
  },
  "28": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B2",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B2",
    "description": "Such feed includes curiel roots, sylkis buds, mimett gourds, and pahsana fruits.",
    "translation_description": ""
  },
  "29": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B3",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B3",
    "description": "Should you reward a chocobo with the same feed continuously, it will become his \u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003Efavorite feed\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E, and the beneficial effects granted by it when he is deployed will be enhanced.",
    "translation_description": ""
  },
  "30": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B4",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_B4",
    "description": "Additionally, when your chocobo has attained the maximum rank, feeding it a Thavnairian onion will raise this upper limit.",
    "translation_description": ""
  },
  "31": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C1",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C1",
    "description": "It is possible to train others\u0027 chocobos if you have the authority to do so.",
    "translation_description": ""
  },
  "32": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C2",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C2",
    "description": "Should you choose to share your private estate with another individual, you may grant them the authority to stable their chocobo and train others\u0027 as well.",
    "translation_description": ""
  },
  "33": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C3",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C3",
    "description": "In the case of apartments, you can also train the chocobos of those who have a room in the same building.",
    "translation_description": ""
  },
  "34": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C4",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C4",
    "description": "In order to train another\u0027s chocobo, a certain period of time must elapse after the creature has been stabled.",
    "translation_description": ""
  },
  "35": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C5",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_TRAIN_C5",
    "description": "Training conducted by the chocobo\u0027s owner as opposed to that conducted by someone else is considered separate; the recuperation time of one does not affect the other. Furthermore, you cannot raise the maximum rank of others\u0027 chocobos, nor can you influence their feed preferences.",
    "translation_description": ""
  },
  "36": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_1",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_1",
    "description": "Training is more effective if a chocobo is housed in a clean stable.",
    "translation_description": ""
  },
  "37": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_2",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CLEAN_2",
    "description": "Stables can be cleaned with \u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003Emagicked stable brooms\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E.",
    "translation_description": ""
  },
  "38": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A1",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A1",
    "description": "If you wish to change your chocobo\u0027s plumage, you may \u003Chex:024804F201F403\u003E\u003Chex:024904F201F503\u003Efeed\u003Chex:0249020103\u003E\u003Chex:0248020103\u003E him snacks.",
    "translation_description": ""
  },
  "39": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A2",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A2",
    "description": "Snacks include Xelphatol apples, valfruits, Mamook pears, Cieldalaes pineapples, O\u0027Ghomoro berries, and Doman plums. Each of these snacks will affect your chocobo\u0027s plumage in different ways.",
    "translation_description": ""
  },
  "40": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A3",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A3",
    "description": "After first feeding your chocobo, you must allow him to rest in his stable for at least six hours to ensure that his plumage changes color.",
    "translation_description": ""
  },
  "41": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A4",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_A4",
    "description": "No change will occur if you take your chocobo out of the stable prematurely.",
    "translation_description": ""
  },
  "42": {
    "name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_B1",
    "translation_name": "TEXT_CMNDEFHOUSINGBUDDYSTABLE_00201_EXPLAIN_CHANGE_COLOR_B1",
    "description": "Feeding your chocobo a Han lemon will revert his plumage to the original yellow hue.",
    "translation_description": ""
  },
