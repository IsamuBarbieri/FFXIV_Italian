{
  "0": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_REDBRIX_000_000",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_REDBRIX_000_000",
    "description": "Pshkohhh... Uplander is curious, wishes to enter giant of iron? Very well, if uplander is heartset, Redbrix will guide. ",
    "translation_description": "Pshkohhh... Gente di sopra è curiosa, vuole entrare nel gigante di ferro? Va bene: se è decisa, Redbrix guida. "
  },
  "1": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_Q1_000_010",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_Q1_000_010",
    "description": "What would you like to do?",
    "translation_description": "Cosa desideri fare?"
  },
  "2": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A1_000_011",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A1_000_011",
    "description": "Ask about Gordias (Savage).",
    "translation_description": "Chiedi informazioni su Gordias (Selvaggio)."
  },
  "3": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A1_000_012",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A1_000_012",
    "description": "Enter <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (Loot Rule: Normal).",
    "translation_description": "Entra in <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (regola bottino: Normale)."
  },
  "4": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A1_100_012",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A1_100_012",
    "description": "Enter <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (Loot Rule: Greed Only).",
    "translation_description": "Entra in <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (regola bottino: Solo Brama)."
  },
  "5": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A1_101_012",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A1_101_012",
    "description": "Enter <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (Loot Rule: Lootmaster).",
    "translation_description": "Entra in <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (regola bottino: assegnazione al capogruppo)."
  },
  "6": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A1_000_013",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A1_000_013",
    "description": "Nothing.",
    "translation_description": "Niente."
  },
  "7": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_00105_Q3_000_015",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_00105_Q3_000_015",
    "description": "What would you like to ask about?",
    "translation_description": "Che cosa vuoi sapere?"
  },
  "8": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_00105_A3_000_016",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_00105_A3_000_016",
    "description": "Entry requirements for Gordias (Savage).",
    "translation_description": "Requisiti di accesso a Gordias (Selvaggio)."
  },
  "9": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_00105_A3_000_017",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_00105_A3_000_017",
    "description": "Nothing.",
    "translation_description": "Niente."
  },
  "10": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_REDBRIX_000_020",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_REDBRIX_000_020",
    "description": "Pshkohhh... Uplander has been given leave to enter inside─though Redbrix does not know why you would. But Redbrix will open the way if uplander asks.",
    "translation_description": "Pshkohhh... Gente di sopra ha il permesso di entrare... ma Redbrix non capisce perché lo voglia. Se glielo chiede, Redbrix aprirà il passaggio."
  },
  "11": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_050",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_050",
    "description": "Gordias (Savage) is comprised of multiple dungeons. Please be warned that the spell Return cannot be used in certain dungeons.",
    "translation_description": "Gordias (Selvaggio) comprende più spedizioni. Attenzione: in alcune non è possibile usare l'incantesimo Ritorno."
  },
  "12": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_051",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_051",
    "description": "Progress within Gordias (Savage) is saved at specific locations for each player, and you may resume your foray where you left off.",
    "translation_description": "I progressi in Gordias (Selvaggio) vengono salvati in punti specifici per ogni giocatore; potrai riprendere l'esplorazione da dove l'hai interrotta."
  },
  "13": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_052",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_052",
    "description": "Progress is reset every <hex:020603120303><hex:020942DDFF0753756E646179FF074D6F6E646179FF0854756573646179FF0A5765646E6573646179FF095468757273646179FF07467269646179FF09536174757264617903> at <hex:020821DBFF1D020919DB02030405060708090A0B0C0D02030405060708090A0B0C030D03> <hex:020810E0DB0DFF05702E6D2EFF05612E6D2E03> (Earth time).",
    "translation_description": "La progressione si azzera ogni <hex:020603120303><hex:020947DDFF09646F6D656E696361FF086C756E6564C3ACFF096D6172746564C3ACFF0B6D6572636F6C6564C3ACFF0967696F766564C3ACFF0976656E657264C3ACFF0773616261746F03> alle <hex:020821DBFF1D020919DB02030405060708090A0B0C0D02030405060708090A0B0C030D03> <hex:020810E0DB0DFF05702E6D2EFF05612E6D2E03> (ora terrestre)."
  },
  "14": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_053",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_053",
    "description": "To enter Gordias (Savage), you must be in a party of eight Disciples of War or Magic with a level of 60 or higher.",
    "translation_description": "Per accedere a Gordias (Selvaggio), devi far parte di un gruppo di otto Discepoli della Guerra o della Magia di livello 60 o superiore."
  },
  "15": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_054",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_054",
    "description": "All members must also have completed the quest “A Song of Steam and Steel.”",
    "translation_description": "Tutti i membri devono aver completato anche la missione «Un canto di vapore e acciaio»."
  },
  "16": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_055",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_055",
    "description": "The starting point is determined by the party leader's progress.",
    "translation_description": "Il punto di partenza dipende dai progressi del capogruppo."
  },
  "17": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_056",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_056",
    "description": "Even party members whose progress is different may participate, provided they meet the entry requirements.",
    "translation_description": "Anche i membri del gruppo con una progressione diversa possono partecipare, purché soddisfino i requisiti di accesso."
  },
  "18": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_100_056",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_100_056",
    "description": "Those who have not advanced as far as the party leader will have their progress updated to be the same as that of the leader.",
    "translation_description": "Chi è meno avanti del capogruppo vedrà i propri progressi aggiornati allo stesso punto."
  },
  "19": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_057",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_057",
    "description": "Those who have advanced further than the party leader, on the other hand, will retain their progress.",
    "translation_description": "Chi invece è più avanti del capogruppo manterrà i propri progressi."
  },
  "20": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_100_057",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_100_057",
    "description": "In this latter case, you will not receive rewards from dungeons that you have already completed, and the number of coffers that pop will be adjusted accordingly.",
    "translation_description": "In tal caso non riceverai ricompense dalle spedizioni già completate; anche il numero di forzieri che appariranno verrà adeguato di conseguenza."
  },
  "21": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_058",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_058",
    "description": "All forays into Gordias (Savage) are limited to 90 minutes (Earth time).",
    "translation_description": "Ogni spedizione in Gordias (Selvaggio) ha un limite di 90 minuti terrestri."
  },
  "22": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_059",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_059",
    "description": "All items in a player's loot list will automatically be transferred to that player's inventory upon all other party members leaving the area.",
    "translation_description": "Quando tutti gli altri membri del gruppo avranno lasciato l'area, gli oggetti nell'elenco bottino di ogni giocatore verranno trasferiti automaticamente nel suo inventario."
  },
  "23": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_060",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_060",
    "description": "Items unable to be obtained will be lost.",
    "translation_description": "Gli oggetti che non potrai ottenere andranno perduti."
  },
  "24": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_Q2_000_100",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_Q2_000_100",
    "description": "Enter <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (Loot Rule: Normal)?",
    "translation_description": "Vuoi entrare in <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (regola bottino: Normale)?"
  },
  "25": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_Q2_100_100",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_Q2_100_100",
    "description": "Enter <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (Loot Rule: Greed Only)?",
    "translation_description": "Vuoi entrare in <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (regola bottino: Solo Brama)?"
  },
  "26": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_Q2_101_100",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_Q2_101_100",
    "description": "Enter <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (Loot Rule: Lootmaster)?",
    "translation_description": "Vuoi entrare in <hex:022815FF10496E7374616E6365436F6E74656E74E8020403> (regola bottino: assegnazione al capogruppo)?"
  },
  "27": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A2_000_101",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A2_000_101",
    "description": "Yes",
    "translation_description": "Sì"
  },
  "28": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A2_000_102",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A2_000_102",
    "description": "No",
    "translation_description": "No"
  },
  "29": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_110",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_110",
    "description": "You were unable to enter <hex:022815FF10496E7374616E6365436F6E74656E74E8030403>. Make sure that you and your party meet all the conditions.",
    "translation_description": "Impossibile entrare in <hex:022815FF10496E7374616E6365436F6E74656E74E8030403>. Assicurati che tu e il tuo gruppo soddisfiate tutti i requisiti."
  },
  "30": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_REDBRIX_000_200",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_REDBRIX_000_200",
    "description": "Pssshkoh... Giant of metal is holding fast to land, and Slowfix is telling Redbrix to keep eyes on big hand!",
    "translation_description": "Pssshkoh... Il gigante di metallo si tiene ben saldo alla riva e Slowfix dice a Redbrix di tenere d'occhio la mano enorme!"
  },
  "31": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_210",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_210",
    "description": "You have recently completed Gordias (Savage), and cannot enter again until progress is reset.",
    "translation_description": "Hai appena completato Gordias (Selvaggio) e non potrai rientrarvi finché i progressi non verranno azzerati."
  },
  "32": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_211",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_SYSTEM_000_211",
    "description": "Progress is reset every <hex:020603120303><hex:020942DDFF0753756E646179FF074D6F6E646179FF0854756573646179FF0A5765646E6573646179FF095468757273646179FF07467269646179FF09536174757264617903> at <hex:020821DBFF1D020919DB02030405060708090A0B0C0D02030405060708090A0B0C030D03> <hex:020810E0DB0DFF05702E6D2EFF05612E6D2E03> (Earth time).",
    "translation_description": "La progressione si azzera ogni <hex:020603120303><hex:020947DDFF09646F6D656E696361FF086C756E6564C3ACFF096D6172746564C3ACFF0B6D6572636F6C6564C3ACFF0967696F766564C3ACFF0976656E657264C3ACFF0773616261746F03> alle <hex:020821DBFF1D020919DB02030405060708090A0B0C0D02030405060708090A0B0C030D03> <hex:020810E0DB0DFF05702E6D2EFF05612E6D2E03> (ora terrestre)."
  },
  "33": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_Q3_000_300",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_Q3_000_300",
    "description": "Awaiting entry confirmation from party members.",
    "translation_description": "In attesa della conferma di accesso da parte dei membri del gruppo."
  },
  "34": {
    "name": "TEXT_RAIDGUIDEENTRANCE30_A3_000_301",
    "translation_name": "TEXT_RAIDGUIDEENTRANCE30_A3_000_301",
    "description": "Cancel",
    "translation_description": "Annulla"
  },
