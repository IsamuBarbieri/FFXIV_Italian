{
  "0": {
    "tag": "TEXT_BANALL010_01465_SEQ_00",
    "original": "Scarlet would commend you for your work among the disparate societies of Eorzea, and entreat your further aid.",
    "translation": ""
  },
  "1": {
    "tag": "TEXT_BANALL010_01465_SEQ_01",
    "original": "Lieutenant Scarlet expresses her gratitude for your accomplishments, which have laid the groundwork upon which enduring peace with the beast tribes of Eorzea may one day be achieved. Valuing your diplomatic skills highly, she would seek your aid with an important task. Inquire with Lieutenant Gavin as to the details.",
    "translation": ""
  },
  "2": {
    "tag": "TEXT_BANALL010_01465_SEQ_02",
    "original": "Lieutenant Gavin is heartened by your presence, having heard of your peace-building exploits with the beast tribes. To learn more of the task the Twin Adder would entrust to you, speak with the lieutenant anew.",
    "translation": ""
  },
  "24": {
    "tag": "TEXT_BANALL010_01465_TODO_00",
    "original": "Speak with Gavin.",
    "translation": ""
  },
  "48": {
    "tag": "TEXT_BANALL010_01465_SCARLET_000_000",
    "original": "\u003Chex:\u003E. On behalf of the entire Order of the Twin Adder, I extend to you our highest accolades.",
    "translation": ""
  },
  "49": {
    "tag": "TEXT_BANALL010_01465_SCARLET_000_001",
    "original": "While lasting peace with the beast tribes will not come easily, your efforts have laid the foundation upon which such a peace may one day be built.",
    "translation": ""
  },
  "50": {
    "tag": "TEXT_BANALL010_01465_SCARLET_000_002",
    "original": "It is to you, our most accomplished ambassador, that I would entrust an assignment of the utmost importance.",
    "translation": ""
  },
  "51": {
    "tag": "TEXT_BANALL010_01465_SCARLET_000_003",
    "original": "Lieutenant Gavin will brief you on the particulars. Godsspeed, \u003Chex:\u003E, and may the elementals watch over you.",
    "translation": ""
  },
  "52": {
    "tag": "TEXT_BANALL010_01465_SCARLET_000_005",
    "original": "Lieutenant Gavin will brief you on the particulars of your mission. Godsspeed, \u003Chex:\u003E, and may the elementals watch over you.",
    "translation": ""
  },
  "53": {
    "tag": "TEXT_BANALL010_01465_GAVIN_000_010",
    "original": "\u003Chex:\u003E! What I\u0027d not give to hear of your adventures with the Ixal over a flagon of mead!",
    "translation": ""
  },
  "54": {
    "tag": "TEXT_BANALL010_01465_GAVIN_000_011",
    "original": "...And yet I fear that more pressing matters demand our attention today. When you are ready for your briefing, you need only say the word.",
    "translation": ""
  }
}