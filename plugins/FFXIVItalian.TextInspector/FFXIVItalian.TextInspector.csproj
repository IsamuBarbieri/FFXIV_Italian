<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0.0</Version>
    <Author>FFXIV Italiano</Author>
    <Name>FFXIV Italiano Text Inspector</Name>
    <Punchline>Trova il file e la riga dietro al testo dell'interfaccia.</Punchline>
